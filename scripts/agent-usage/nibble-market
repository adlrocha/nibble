#!/usr/bin/env python3
"""Market token-price records for the omarchy agents panel.

One analysis card ("Market", accent row): best blended €/Mtok per model
family across public price sources, the 30-day trend, and what the last 30
days of nibble-tracked usage would cost at today's rates. Everything is
auto-fetched; there is no config file and nothing to maintain.

Inputs (all public, no auth):
  https://models.dev/api.json            per-Mtok costs, 225 providers
  https://openrouter.ai/api/v1/models    per-token costs, 460+ variants
  https://api.frankfurter.app/latest     USD→EUR rate (fallback 0.92)
  ~/.nibble/tasks.db token_usage         30-day volume + in/out/cache split

State:
  ~/.local/state/omarchy/agents/usage/market.json   the panel record
  ~/.local/state/nibble/market/market-history.jsonl 365-day daily snapshots

Usage:
  nibble-market               # print the record as JSON
  nibble-market --write       # write the record (what the timer runs)
  nibble-market --force       # re-fetch prices, ignoring the 10-min cache
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sqlite3
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

PROBE_MIN_INTERVAL_SECONDS = 600
HISTORY_MAX_DAYS = 365
HTTP_TIMEOUT = 15
FALLBACK_USD_EUR = 0.92

MODELSDEV_URL = "https://models.dev/api.json"
OPENROUTER_URL = "https://openrouter.ai/api/v1/models"
FX_URL = "https://api.frankfurter.app/latest?from=USD&to=EUR"

# Model-id fragments → family. Families are the unit of comparison: a price
# pulse per tier (flash / flagship), not per vendor SKU. `exclude` wins:
# GLM-5.3-Flash must not price as flagship just because it contains "glm-5.".
FAMILY_MATCHERS = {
    "flash": {
        "match": ("flash", "flashx", "lite", "mini", "turbo", "small"),
        "exclude": (),
    },
    "flagship": {
        "match": ("glm-5.", "kimi-k", "deepseek-v4-pro", "qwen3-max", "qwen3-plus", "minimax-m3"),
        "exclude": ("flash", "flashx", "lite", "mini", "turbo"),
    },
}

# Routing variants are not the price of interactive traffic; keep them out of
# every floor.
VARIANT_MARKERS = (":free", ":batch", ":nitro", ":floor", ":exacto", "promo")


# ------------------------------------------------------------------ paths/io


def state_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "nibble/market"
    root.mkdir(parents=True, exist_ok=True)
    return root


def panel_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy/agents/usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy/agent-usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def write_json(path: Path, payload: dict) -> None:
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
        tmp.chmod(0o600)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def nibble_db() -> Path:
    return Path.home() / ".nibble" / "tasks.db"


def today_str() -> str:
    return dt.datetime.now(dt.timezone.utc).date().isoformat()


def family_pattern(family: str) -> re.Pattern | None:
    spec = FAMILY_MATCHERS.get(family)
    if not spec:
        return None
    return re.compile("|".join(re.escape(m) for m in spec["match"]), re.IGNORECASE)


def family_excludes(family: str) -> tuple[str, ...]:
    spec = FAMILY_MATCHERS.get(family)
    return spec["exclude"] if spec else ()


# ------------------------------------------------------------- market fetching


def http_get(url: str, headers: dict | None = None) -> bytes | None:
    request = urllib.request.Request(url, headers={"Accept": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            return response.read()
    except Exception:
        return None


def usd_to_eur() -> float:
    payload = http_get(FX_URL)
    if payload:
        try:
            rate = json.loads(payload).get("rates", {}).get("EUR")
            if isinstance(rate, (int, float)) and 0.5 < rate < 1.5:
                return float(rate)
        except Exception:
            pass
    return FALLBACK_USD_EUR


def fetch_market(force: bool) -> list[dict]:
    """[{provider, model, input, output, cache_read}] — USD per Mtok."""
    cache = cache_root() / "market-prices.json"
    if not force:
        cached = read_json(cache)
        if cached and time.time() - cached.get("fetchedAtMs", 0) / 1000 < PROBE_MIN_INTERVAL_SECONDS:
            return cached.get("rows", [])

    rows: list[dict] = []

    payload = http_get(MODELSDEV_URL)
    if payload:
        try:
            data = json.loads(payload.decode("utf-8", errors="replace"))
            for provider, block in data.items():
                for model_id, model in (block or {}).get("models", {}).items():
                    cost = model.get("cost") if isinstance(model, dict) else None
                    if isinstance(cost, dict) and isinstance(cost.get("input"), (int, float)):
                        rows.append({
                            "provider": provider,
                            "model": model_id,
                            "input": float(cost["input"]),
                            "output": float(cost.get("output") or 0),
                            "cache_read": float(cost.get("cache_read") or 0),
                        })
        except Exception:
            pass

    payload = http_get(OPENROUTER_URL)
    if payload:
        try:
            data = json.loads(payload.decode("utf-8", errors="replace"))
            for model in data.get("data", []):
                pricing = model.get("pricing") or {}
                try:
                    # OpenRouter prices are USD strings per single token.
                    inp = float(pricing.get("prompt")) * 1e6
                    out = float(pricing.get("completion")) * 1e6
                except (TypeError, ValueError):
                    continue
                if inp <= 0 and out <= 0:
                    continue
                rows.append({
                    "provider": "openrouter",
                    "model": model.get("id", ""),
                    "input": round(inp, 4),
                    "output": round(out, 4),
                    "cache_read": round(float(pricing.get("input_cache_read") or 0) * 1e6, 4),
                })
        except Exception:
            pass

    if rows:
        write_json(cache, {"fetchedAtMs": round(time.time() * 1000), "rows": rows})
    else:
        cached = read_json(cache)
        if cached:
            return cached.get("rows", [])
    return rows


def append_history(rows: list[dict]) -> None:
    """One line per (provider, model) per day; keep HISTORY_MAX_DAYS."""
    path = state_dir() / "market-history.jsonl"
    today = today_str()
    seen_today: set[tuple[str, str]] = set()
    cutoff = (dt.datetime.now(dt.timezone.utc).date() - dt.timedelta(days=HISTORY_MAX_DAYS)).isoformat()
    lines: list[str] = []
    if path.is_file():
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if str(entry.get("date", "")) < cutoff:
                continue
            lines.append(line)
            if entry.get("date") == today:
                seen_today.add((str(entry.get("provider")), str(entry.get("model"))))
    for row in rows:
        key = (row["provider"], row["model"])
        if key in seen_today:
            continue
        lines.append(json.dumps({"date": today, **row}, separators=(",", ":"), sort_keys=True))
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
        tmp.chmod(0o600)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


# --------------------------------------------------------------- local usage


def usage_30d() -> dict:
    """30-day token volume and in/out/cache split from nibble's token_usage."""
    result = {
        "providers": {},       # api_provider → mtokens 30d
        "families": {},        # family → mtokens 30d
        "in_ratio": 0.25, "out_ratio": 0.75, "cache_ratio": 0.0,  # fallback split
        "user_models": set(),
    }
    db_path = nibble_db()
    if not db_path.is_file():
        return result
    cutoff = int(time.time()) - 30 * 86400
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=3)
        try:
            rows = con.execute(
                """SELECT api_provider, model, input_tokens, output_tokens,
                          cache_read_tokens, cache_write_tokens
                   FROM token_usage WHERE ts >= ?""",
                (cutoff,),
            ).fetchall()
        finally:
            con.close()
    except Exception:
        return result

    total_in = total_out = total_cache = 0
    family_patterns = {f: family_pattern(f) for f in FAMILY_MATCHERS}
    family_patterns = {f: p for f, p in family_patterns.items() if p}
    for provider, model, tin, tout, cread, cwrite in rows:
        mtok = ((tin or 0) + (tout or 0) + (cread or 0) + (cwrite or 0)) / 1e6
        if mtok <= 0:
            continue
        model_name = str(model or "")
        result["providers"][provider or "unknown"] = result["providers"].get(provider or "unknown", 0.0) + mtok
        if model_name:
            result["user_models"].add(model_name.strip().lower().split("/")[-1])
        total_in += tin or 0
        total_out += tout or 0
        total_cache += (cread or 0) + (cwrite or 0)
        for family, pattern in family_patterns.items():
            if pattern.search(model_name):
                result["families"][family] = result["families"].get(family, 0.0) + mtok
    total = total_in + total_out + total_cache
    if total > 0:
        result["in_ratio"] = total_in / total
        result["out_ratio"] = total_out / total
        result["cache_ratio"] = total_cache / total
    return result


# ---------------------------------------------------------------- computation


def family_floor(history_path: Path, family: str, in_ratio: float, out_ratio: float, cache_ratio: float,
                 user_models: set[str]) -> dict | None:
    """Best blended rate across sources for a family, now vs 30 days ago."""
    pattern = family_pattern(family)
    if not pattern:
        return None
    excludes = family_excludes(family)
    cutoff_30 = (dt.datetime.now(dt.timezone.utc).date() - dt.timedelta(days=30)).isoformat()
    today: dict[tuple[str, str], float] = {}
    past: dict[tuple[str, str], float] = {}
    if not history_path.is_file():
        return None
    for line in history_path.read_text(encoding="utf-8").splitlines():
        try:
            entry = json.loads(line)
        except Exception:
            continue
        model_id = str(entry.get("model", ""))
        if not pattern.search(model_id):
            continue
        lowered = model_id.lower()
        # Exclusion is a whole-id check: a lookahead anchored regex can't see
        # "flash" appearing *after* the matched fragment ("glm-5.3-flash").
        if any(x in lowered for x in excludes):
            continue
        if any(v in lowered for v in VARIANT_MARKERS):
            continue
        # Cache reads dominate coding workloads and cost ~10x less than fresh
        # input; price them at the cache rate so floors match reality. Rows
        # without a cache price default it to the full input price (conservative).
        cache_price = float(entry.get("cache_read") or 0) or float(entry.get("input") or 0)
        blended = (float(entry.get("input") or 0) * in_ratio
                   + float(entry.get("output") or 0) * out_ratio
                   + cache_price * cache_ratio)
        key = (str(entry.get("provider")), model_id)
        if blended <= 0:
            continue
        if entry.get("date") == today_str():
            today[key] = blended
        elif str(entry.get("date", "")) <= cutoff_30:
            past[key] = blended
    if not today:
        return None
    # The honest comparator is the rate of the models this machine actually
    # runs, not the global promo minimum. Prefer market ids covering the
    # user's 30-day model set; fall back to the family min.
    comparable = [k for k in today
                  if any(u and (u in k[1].lower() or k[1].lower().endswith(u)) for u in user_models)]
    pool = comparable or list(today)
    best_key = min(pool, key=today.get)
    floor = today[best_key]
    result = {"provider": best_key[0], "model": best_key[1], "usd_per_mtok": round(floor, 4)}
    comparable_past = {k: v for k, v in past.items() if k[1] == best_key[1]}
    if comparable_past:
        past_best = min(comparable_past.values())
        if past_best > 0:
            result["change_30d"] = round((floor - past_best) / past_best, 3)
    return result


def compute() -> dict:
    fx = usd_to_eur()
    market = fetch_market(False)
    if market:
        append_history(market)
    usage = usage_30d()
    in_ratio, out_ratio = usage["in_ratio"], usage["out_ratio"]
    cache_ratio = usage["cache_ratio"]
    history = state_dir() / "market-history.jsonl"

    families_out = []
    floor_lines = []
    at_market_eur = 0.0
    for family, mtok in sorted(usage["families"].items(), key=lambda kv: -kv[1]):
        floor = family_floor(history, family, in_ratio, out_ratio, cache_ratio, usage["user_models"])
        if not floor:
            continue
        floor_eur = floor["usd_per_mtok"] * fx
        at_market_eur += mtok * floor_eur
        trend = ""
        if floor.get("change_30d") is not None:
            arrow = "▼" if floor["change_30d"] < 0 else "▲"
            trend = f" {arrow}{abs(floor['change_30d']) * 100:.0f}%"
        families_out.append({
            "family": family,
            "mtok_30d": round(mtok, 1),
            "floor": {**floor, "eur_per_mtok": round(floor_eur, 4)},
            "change_30d": floor.get("change_30d"),
        })
        short_model = floor["model"].split("/")[-1]
        floor_lines.append(f"{family} {floor_eur:.3f} €/Mtok ({short_model} @ {floor['provider']}){trend}")

    total_mtok = sum(usage["families"].values())
    banner = " · ".join(floor_lines)
    if at_market_eur > 0:
        banner += f" · your 30d ≈ {at_market_eur:.2f} € at market"

    flash = next((f for f in families_out if f["family"] == "flash"), None)
    trend_label = ""
    if flash and flash.get("change_30d") is not None:
        arrow = "▼" if flash["change_30d"] < 0 else "▲"
        trend_label = f" {arrow}{abs(flash['change_30d']) * 100:.0f}%/30d"

    return {
        "schemaVersion": 1,
        "id": "market",
        "name": "Market",
        "kind": "analysis",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": bool(families_out),
        "hasLocalStats": False,
        "tierLabel": (f"flash {flash['floor']['eur_per_mtok']:.3f} €/Mtok{trend_label}"
                      if flash else "no market data yet"),
        "usageStatusText": banner or "Collecting prices — the first snapshots land within a day",
        # The panel's status banner body renders authHelpText (usageStatusText
        # only gates visibility), so the pulse lives here.
        "authHelpText": banner or "Prices auto-fetched from models.dev and OpenRouter.",
        "limits": [],
        "balance": None,
        "market": {
            "sources": ["models.dev", "openrouter"],
            "usd_to_eur": fx,
            "families": families_out,
            "mtok_30d_at_market_eur": round(at_market_eur, 2),
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Market token-price record for the omarchy agents panel")
    parser.add_argument("--write", action="store_true", help="write the record for the panel instead of printing")
    parser.add_argument("--force", action="store_true", help="re-fetch market prices ignoring the cache")
    args = parser.parse_args()

    try:
        record = compute()
    except Exception as error:
        print(f"nibble-market: failed: {error}", file=sys.stderr)
        return 1
    if args.write:
        write_json(panel_dir() / "market.json", record)
    else:
        print(json.dumps(record, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
