#!/usr/bin/env python3
"""Budget + market + self-host break-even records for the omarchy agents panel.

Answers one question: "at my current token volume, when does self-hosting beat
paying for inference?" It writes two panel records (same contract as
nibble-agent-usage):

  budget.json  monthly spend vs budget, effective €/Mtok per subscription,
               and the self-host break-even verdict per model family
  market.json  market price pulse: best per-token rates per family across
               providers, 30-day trend, watched-hardware prices

Inputs:
  ~/.nibble/budget.toml                    subscriptions, self-host scenarios,
                                           hardware watch list (seeded on first run)
  ~/.nibble/tasks.db token_usage           actual token volume per provider/model
  https://models.dev/api.json              market per-Mtok costs (Fireworks,
                                           Together, DeepSeek, Z.AI, Moonshot, …)
  https://openrouter.ai/api/v1/models      market per-token costs (460+ variants)

History: ~/.local/state/nibble/budget/market-history.jsonl — one line per
model per day, trimmed to 365 days; powers the trend line.

Usage:
  nibble-budget               # compute, print both records as JSON
  nibble-budget --write       # write records for the panel (what the timer runs)
  nibble-budget --force       # re-fetch market prices, ignoring the 10-min cache
  nibble-budget --seed-config # write the default budget.toml if missing, then exit
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sqlite3
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

PROBE_MIN_INTERVAL_SECONDS = 600
HISTORY_MAX_DAYS = 365
HTTP_TIMEOUT = 15

MODELSDEV_URL = "https://models.dev/api.json"
OPENROUTER_URL = "https://openrouter.ai/api/v1/models"

# Model-id fragments → family. Families are the unit of comparison: a
# self-host box serves a tier (flash / flagship), not a specific vendor SKU.
# `exclude` wins: GLM-5.3-Flash must not price as flagship just because it
# contains "glm-5.".
FAMILY_MATCHERS = {
    "flash": {
        "match": ("flash", "flashx", "lite", "mini", "turbo", "small"),
        "exclude": (),
    },
    "flagship": {
        "match": ("glm-5.", "kimi-k", "deepseek-v4-pro", "qwen3-max", "qwen3-plus", "minimax-m3"),
        "exclude": ("flash", "flashx", "lite", "mini", "turbo"),
    },
}


def family_pattern(family: str) -> re.Pattern | None:
    spec = FAMILY_MATCHERS.get(family)
    if not spec:
        return None
    return re.compile("|".join(re.escape(m) for m in spec["match"]), re.IGNORECASE)


def family_excludes(family: str) -> tuple[str, ...]:
    spec = FAMILY_MATCHERS.get(family)
    return spec["exclude"] if spec else ()


