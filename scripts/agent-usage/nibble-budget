# ------------------------------------------------------------------ paths/io


def nibble_dir() -> Path:
    return Path.home() / ".nibble"


def config_path() -> Path:
    return nibble_dir() / "budget.toml"


def state_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "nibble/budget"
    root.mkdir(parents=True, exist_ok=True)
    return root


def panel_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy/agents/usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy/agent-usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def write_json(path: Path, payload: dict) -> None:
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
        tmp.chmod(0o600)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def parse_toml(text: str) -> dict:
    try:
        import tomllib
        return tomllib.loads(text)
    except ModuleNotFoundError:  # python < 3.11
        import tomli as tomllib  # type: ignore
        return tomllib.loads(text)


def load_config() -> dict:
    path = config_path()
    if not path.is_file():
        path.write_text(DEFAULT_CONFIG, encoding="utf-8")
        return parse_toml(DEFAULT_CONFIG)
    return parse_toml(path.read_text(encoding="utf-8"))


# ------------------------------------------------------------- market fetching


def http_get(url: str, headers: dict | None = None) -> bytes | None:
    request = urllib.request.Request(url, headers={"Accept": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            return response.read()
    except Exception:
        return None


def fetch_market(force: bool) -> list[dict]:
    """[{provider, model, input, output, cache_read}] — USD per Mtok."""
    cache = cache_root() / "budget-market.json"
    if not force:
        cached = read_json(cache)
        if cached and time.time() - cached.get("fetchedAtMs", 0) / 1000 < PROBE_MIN_INTERVAL_SECONDS:
            return cached.get("rows", [])

    rows: list[dict] = []

    payload = http_get(MODELSDEV_URL)
    if payload:
        try:
            data = json.loads(payload.decode("utf-8", errors="replace"))
            for provider, block in data.items():
                for model_id, model in (block or {}).get("models", {}).items():
                    cost = model.get("cost") if isinstance(model, dict) else None
                    if isinstance(cost, dict) and isinstance(cost.get("input"), (int, float)):
                        rows.append({
                            "provider": provider,
                            "model": model_id,
                            "input": float(cost["input"]),
                            "output": float(cost.get("output") or 0),
                            "cache_read": float(cost.get("cache_read") or 0),
                        })
        except Exception:
            pass

    payload = http_get(OPENROUTER_URL)
    if payload:
        try:
            data = json.loads(payload.decode("utf-8", errors="replace"))
            for model in data.get("data", []):
                pricing = model.get("pricing") or {}
                try:
                    # OpenRouter prices are USD strings per single token.
                    inp = float(pricing.get("prompt")) * 1e6
                    out = float(pricing.get("completion")) * 1e6
                except (TypeError, ValueError):
                    continue
                if inp <= 0 and out <= 0:
                    continue
                rows.append({
                    "provider": "openrouter",
                    "model": model.get("id", ""),
                    "input": round(inp, 4),
                    "output": round(out, 4),
                    "cache_read": round(float(pricing.get("input_cache_read") or 0) * 1e6, 4),
                })
        except Exception:
            pass

    if rows:
        write_json(cache, {"fetchedAtMs": round(time.time() * 1000), "rows": rows})
    else:
        cached = read_json(cache)
        if cached:
            return cached.get("rows", [])
    return rows


def append_history(rows: list[dict]) -> None:
    """One line per (provider, model) per day; keep HISTORY_MAX_DAYS."""
    path = state_dir() / "market-history.jsonl"
    today = dt.datetime.now(dt.timezone.utc).date().isoformat()
    seen_today: set[tuple[str, str]] = set()
    cutoff = (dt.datetime.now(dt.timezone.utc).date() - dt.timedelta(days=HISTORY_MAX_DAYS)).isoformat()
    lines: list[str] = []
    if path.is_file():
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if str(entry.get("date", "")) < cutoff:
                continue
            lines.append(line)
            if entry.get("date") == today:
                seen_today.add((str(entry.get("provider")), str(entry.get("model"))))
    for row in rows:
        key = (row["provider"], row["model"])
        if key in seen_today:
            continue
        lines.append(json.dumps({"date": today, **row}, separators=(",", ":"), sort_keys=True))
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
        tmp.chmod(0o600)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def family_floor(history_path: Path, family: str, in_ratio: float, out_ratio: float, cache_ratio: float) -> dict | None:
    """Best blended €-per-Mtok across all sources for a family, now vs 30d ago."""
    pattern = family_pattern(family)
    if not pattern:
        return None
    cutoff_30 = (dt.datetime.now(dt.timezone.utc).date() - dt.timedelta(days=30)).isoformat()
    excludes = family_excludes(family)
    today: dict[tuple[str, str], float] = {}
    past: dict[tuple[str, str], float] = {}
    if not history_path.is_file():
        return None
    for line in history_path.read_text(encoding="utf-8").splitlines():
        try:
            entry = json.loads(line)
        except Exception:
            continue
        model_id = str(entry.get("model", ""))
        if not pattern.search(model_id):
            continue
        lowered = model_id.lower()
        # Exclusion is a whole-id check: a lookahead anchored regex can't see
        # "flash" appearing *after* the matched fragment ("glm-5.3-flash").
        if any(x in lowered for x in excludes):
            continue
        # Batch/free/nitro routing variants are not the price you'd pay for
        # interactive coding traffic; keep them out of the floor.
        if any(v in lowered for v in (":free", ":batch", ":nitro", ":floor", ":exacto", "promo")):
            continue
        # Cache reads dominate coding workloads and cost ~10x less than fresh
        # input; price them at the cache rate so floors match reality. Rows
        # without a cache price default it to the full input price (conservative).
        cache_price = float(entry.get("cache_read") or 0) or float(entry.get("input") or 0)
        blended = (float(entry.get("input") or 0) * in_ratio
                   + float(entry.get("output") or 0) * out_ratio
                   + cache_price * cache_ratio)
        key = (str(entry.get("provider")), model_id)
        if blended <= 0:
            continue
        if entry.get("date") == today_str():
            today[key] = blended
        elif str(entry.get("date", "")) <= cutoff_30:
            past[key] = blended
    if not today:
        return None
    # The honest comparator for "should I self-host" is the rate of the models
    # this machine actually runs, not the global promo minimum. Prefer market
    # ids covering the user's 30-day model set; fall back to the family min.
    user_models = user_model_set()
    comparable = [k for k in today
                  if any(u and (u in k[1].lower() or k[1].lower().endswith(u)) for u in user_models)]
    pool = comparable or list(today)
    best_key = min(pool, key=today.get)
    floor = today[best_key]
    result = {"provider": best_key[0], "model": best_key[1], "usd_per_mtok": round(floor, 4)}
    comparable_past = {k: v for k, v in past.items() if k[1] == best_key[1]}
    if comparable_past:
        past_best = min(comparable_past.values())
        if past_best > 0:
            result["change_30d"] = round((floor - past_best) / past_best, 3)
    return result


def today_str() -> str:
    return dt.datetime.now(dt.timezone.utc).date().isoformat()


# --------------------------------------------------------------- local usage


_user_models_cache: set[str] | None = None


def user_model_set() -> set[str]:
    """Distinct lowercased model ids this machine actually used in 30 days."""
    global _user_models_cache
    if _user_models_cache is not None:
        return _user_models_cache
    models: set[str] = set()
    db_path = nibble_dir() / "tasks.db"
    if db_path.is_file():
        cutoff = int(time.time()) - 30 * 86400
        try:
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=3)
            try:
                for (model,) in con.execute(
                    "SELECT DISTINCT model FROM token_usage WHERE ts >= ? AND model IS NOT NULL",
                    (cutoff,),
                ):
                    if model:
                        models.add(str(model).strip().lower().split("/")[-1])
            finally:
                con.close()
        except Exception:
            pass
    _user_models_cache = models
    return models


def usage_30d() -> dict:
    """30-day token volume and in/out/cache split from nibble's token_usage."""
    db_path = nibble_dir() / "tasks.db"
    result = {
        "providers": {},       # api_provider → mtokens 30d
        "families": {},        # family → mtokens 30d
        "in_ratio": 0.25, "out_ratio": 0.75, "cache_ratio": 0.0,  # fallback split
    }
    if not db_path.is_file():
        return result
    cutoff = int(time.time()) - 30 * 86400
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=3)
        try:
            rows = con.execute(
                """SELECT api_provider, model, input_tokens, output_tokens,
                          cache_read_tokens, cache_write_tokens
                   FROM token_usage WHERE ts >= ?""",
                (cutoff,),
            ).fetchall()
        finally:
            con.close()
    except Exception:
        return result

    total_in = total_out = total_cache = 0
    family_patterns = {f: family_pattern(f) for f in FAMILY_MATCHERS}
    family_patterns = {f: p for f, p in family_patterns.items() if p}
    for provider, model, tin, tout, cread, cwrite in rows:
        mtok = ((tin or 0) + (tout or 0) + (cread or 0) + (cwrite or 0)) / 1e6
        if mtok <= 0:
            continue
        result["providers"][provider or "unknown"] = result["providers"].get(provider or "unknown", 0.0) + mtok
        total_in += tin or 0
        total_out += tout or 0
        total_cache += (cread or 0) + (cwrite or 0)
        for family, pattern in family_patterns.items():
            if pattern.search(model or ""):
                result["families"][family] = result["families"].get(family, 0.0) + mtok
    total = total_in + total_out + total_cache
    if total > 0:
        result["in_ratio"] = total_in / total
        result["out_ratio"] = total_out / total
        result["cache_ratio"] = total_cache / total
    return result


# ---------------------------------------------------------------- computation


def selfhost_row(scenario: dict) -> dict:
    monthly_hw = float(scenario.get("hardware_price_eur") or 0) / max(1, int(scenario.get("amortize_months") or 24))
    monthly_power = (float(scenario.get("power_w") or 0) / 1000.0) * 730 * float(scenario.get("duty_cycle") or 0) * float(scenario.get("kwh_eur") or 0)
    monthly = monthly_hw + monthly_power
    capacity_mtok = (float(scenario.get("tokens_per_sec") or 0) * float(scenario.get("duty_cycle") or 0) * 730 * 3600) / 1e6
    eur_per_mtok = monthly / capacity_mtok if capacity_mtok > 0 else 0.0
    return {
        "name": scenario.get("name", "self-host"),
        "monthly_eur": round(monthly, 2),
        "capacity_mtok_month": round(capacity_mtok),
        "eur_per_mtok": round(eur_per_mtok, 4),
        "families": list(scenario.get("serve_families", [])),
    }


def compute() -> tuple[dict, dict]:
    cfg = load_config()
    fx = float(cfg.get("usd_to_eur") or 1.0)
    budget = float(cfg.get("budget_monthly_eur") or 0)
    market = fetch_market(False)
    if market:
        append_history(market)
    usage = usage_30d()
    in_ratio, out_ratio = usage["in_ratio"], usage["out_ratio"]
    cache_ratio = usage.get("cache_ratio", 0.0)
    history = state_dir() / "market-history.jsonl"

    # --- budget record
    sub_spend = sum(float(s.get("price_eur") or 0) for s in cfg.get("subscriptions", []))
    total_mtok = sum(usage["providers"].values())
    sub_lines = []
    for sub in cfg.get("subscriptions", []):
        mtok = usage["providers"].get(str(sub.get("provider_id")), 0.0)
        effective = (sub["price_eur"] / mtok) if mtok > 0 and float(sub.get("price_eur") or 0) > 0 else None
        sub_lines.append({
            "name": sub.get("name"), "price_eur": sub.get("price_eur"),
            "mtok_30d": round(mtok, 1),
            "effective_eur_per_mtok": round(effective, 4) if effective else None,
        })

    families_out = []
    verdicts = []
    for family, mtok in sorted(usage["families"].items(), key=lambda kv: -kv[1]):
        floor = family_floor(history, family, in_ratio, out_ratio, cache_ratio)
        if not floor:
            continue
        floor_eur = floor["usd_per_mtok"] * fx
        entry = {
            "family": family, "mtok_30d": round(mtok, 1),
            "floor": {**floor, "eur_per_mtok": round(floor_eur, 4)},
        }
        scenarios = [selfhost_row(s) for s in cfg.get("selfhost", [])
                     if family in (s.get("serve_families") or [])]
        # Break-even volume: the box's fixed monthly cost divided by the API
        # rate it displaces. Above this many Mtok/month, owning beats renting
        # tokens (self-host marginal token cost ≈ the power already in `monthly`).
        for scenario in scenarios:
            if scenario["eur_per_mtok"] > 0 and floor_eur > 0:
                scenario["break_even_mtok_month"] = round(scenario["monthly_eur"] / floor_eur)
                scenario["market_floor_eur_per_mtok"] = round(floor_eur, 4)
        entry["selfhost"] = scenarios
        families_out.append(entry)
        # Earliest trigger across scenarios decides the verdict.
        be = min((s["break_even_mtok_month"] for s in scenarios if s.get("break_even_mtok_month")), default=None)
        if be:
            if mtok >= be:
                best = min((s for s in scenarios if s["eur_per_mtok"] > 0), key=lambda s: s["eur_per_mtok"], default=None)
                verdicts.append(f"{family}: self-host wins ({best['name']}) — {mtok:.0f}M tok/mo ≥ {be}M break-even")
            else:
                verdicts.append(f"{family}: stay on API — {mtok:.0f}M tok/mo < {be}M break-even")

    verdict = " · ".join(verdicts[:2]) if verdicts else "No usage data yet — token_volume needs 30d of nibble-tracked sessions"
    budget_record = {
        "schemaVersion": 1,
        "id": "budget",
        "name": "Budget",
        "kind": "analysis",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": bool(sub_spend or total_mtok),
        "hasLocalStats": False,
        "tierLabel": f"{sub_spend:.2f} €/mo subs · {total_mtok:.0f}M tok/30d",
        "usageStatusText": verdict,
        # The panel's status banner body renders authHelpText (usageStatusText
        # only gates visibility), so the verdict lives here.
        "authHelpText": verdict,
        "limits": ([{"label": "Monthly budget", "percent": min(1.0, sub_spend / budget), "resetsAt": ""}] if budget > 0 else []),
        "balance": None,
        "budget": {
            "monthly_eur": sub_spend, "budget_eur": budget,
            "subscriptions": sub_lines,
            "families": families_out,
            "usd_to_eur": fx,
        },
    }

    # --- market record
    hw_lines = [f"{h['name']} {h.get('price_eur')}€ ({h.get('price_date')})" for h in cfg.get("hardware_watch", [])]
    flash_floor = family_floor(history, "flash", in_ratio, out_ratio, cache_ratio)
    trend = ""
    if flash_floor and flash_floor.get("change_30d") is not None:
        arrow = "▼" if flash_floor["change_30d"] < 0 else "▲"
        trend = f" {arrow} {abs(flash_floor['change_30d']) * 100:.0f}% / 30d"
    floor_line = (f"flash floor {flash_floor['usd_per_mtok'] * fx:.3f} €/Mtok "
                  f"({flash_floor['model']} @ {flash_floor['provider']}){trend}" if flash_floor else "no market data yet")
    # Trigger-distance meters: family volume ÷ earliest break-even. The meter
    # filling up means self-hosting is approaching worth-it; ≥90% paints it
    # alarming on purpose. These also make the card pass the panel's
    # providerHasData gate, which token-stats-less records otherwise fail.
    trigger_limits = []
    for entry in families_out:
        bes = [s.get("break_even_mtok_month") for s in entry.get("selfhost", []) if s.get("break_even_mtok_month")]
        if not bes:
            continue
        ratio = min(1.0, entry["mtok_30d"] / min(bes))
        trigger_limits.append({"label": f"{entry['family']} self-host trigger", "percent": round(ratio, 4), "resetsAt": ""})
    market_record = {
        "schemaVersion": 1,
        "id": "market",
        "name": "Market",
        "kind": "analysis",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": bool(flash_floor),
        "hasLocalStats": False,
        "tierLabel": (f"flash floor {flash_floor['usd_per_mtok'] * fx:.3f} €/Mtok{trend}" if flash_floor else "no market data"),
        "usageStatusText": " · ".join(hw_lines[:3]) if hw_lines else "Add hardware_watch entries to ~/.nibble/budget.toml",
        "authHelpText": floor_line,
        "limits": trigger_limits,
        "balance": None,
        "market": {
            "sources": ["models.dev", "openrouter"],
            "flash_floor": flash_floor,
            "hardware_watch": cfg.get("hardware_watch", []),
        },
    }
    return budget_record, market_record


def main() -> int:
    parser = argparse.ArgumentParser(description="Budget / market / self-host records for the omarchy agents panel")
    parser.add_argument("--write", action="store_true", help="write records for the panel instead of printing")
    parser.add_argument("--force", action="store_true", help="re-fetch market prices ignoring the cache")
    parser.add_argument("--seed-config", action="store_true", help="write the default budget.toml if missing, then exit")
    args = parser.parse_args()

    if args.seed_config:
        if not config_path().is_file():
            config_path().write_text(DEFAULT_CONFIG, encoding="utf-8")
            print(f"seeded {config_path()}")
        return 0

    try:
        budget_record, market_record = compute()
    except Exception as error:
        print(f"nibble-budget: failed: {error}", file=sys.stderr)
        return 1
    if args.write:
        write_json(panel_dir() / "budget.json", budget_record)
        write_json(panel_dir() / "market.json", market_record)
    else:
        print(json.dumps({"budget": budget_record, "market": market_record}, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
