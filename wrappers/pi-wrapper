#!/bin/bash
# Wrapper for the pi coding agent to track tasks in nibble.
# Creates the task and exports AGENT_TASK_ID for the pi extension
# (nibble-memory.ts) which reports live status: agent_start → running,
# agent_settled → completed, session_shutdown → exited.
#
# Usage:
#   pi [args...]   -- normal interactive mode, tracked by nibble

# Find the original pi binary
PI_BIN=$(which -a pi | grep -v "$(readlink -f "$0")" | head -n 1)

if [ -z "$PI_BIN" ]; then
    echo "Error: Could not find original pi binary" >&2
    exit 1
fi

# Generate unique task ID and export for the pi extension
export AGENT_TASK_ID=$(uuidgen)

# Get repo info if in a git repository
REPO_NAME=""
REPO_BRANCH=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null)
    REPO_BRANCH=$(git branch --show-current 2>/dev/null)
fi

# Build task title with repo/directory info
if [ -n "$REPO_NAME" ]; then
    TASK_TITLE="[$REPO_NAME"
    [ -n "$REPO_BRANCH" ] && TASK_TITLE="$TASK_TITLE:$REPO_BRANCH"
    TASK_TITLE="$TASK_TITLE]"
else
    TASK_TITLE="[$(basename "$PWD")]"
fi
TASK_TITLE="${TASK_TITLE:0:100}"

# Pass zellij pane ID if running inside zellij
EXTRA_FLAGS=""
if [ -n "$ZELLIJ" ] && [ -n "$ZELLIJ_PANE_ID" ]; then
    EXTRA_FLAGS="$EXTRA_FLAGS --zellij-pane-id $ZELLIJ_PANE_ID"
fi

# Register task as 'running'
# shellcheck disable=SC2086
nibble report start "$AGENT_TASK_ID" "pi" "$PWD" "$TASK_TITLE" \
    --pid $$ --ppid $PPID $EXTRA_FLAGS 2>/dev/null || true

# Run pi — the extension handles status updates
exec "$PI_BIN" "$@"
